# Copy the relevant values into client/.env and server/.env.
# Never commit real credentials.

# Client
VITE_API_URL=http://localhost:3000/api

# Server
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/electricity_accountant
CLIENT_ORIGIN=http://localhost:5173
ELECTRON_ORIGIN=app://renderer
TIMEZONE=Asia/Hebron
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=المدير
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Electron development override (normally unnecessary)
ELECTRON_RENDERER_URL=http://localhost:5173
