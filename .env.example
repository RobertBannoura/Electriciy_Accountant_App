# Copy the relevant values into client/.env and server/.env.
# Never commit real credentials.

# Client
VITE_API_URL=http://localhost:3000/api

# Server
NODE_ENV=development
PORT=3000
# Railway requires 0.0.0.0; local/device-only deployments should keep 127.0.0.1.
# Production requires this choice explicitly.
HOST=127.0.0.1
# Replace both placeholders. Production must use a dedicated secret and a TLS-capable endpoint.
DATABASE_URL=postgresql://APP_DB_USER:CHANGE_ME@localhost:5432/electricity_accountant
# Production rejects TLS options embedded in DATABASE_URL so they cannot override
# certificate verification. Supply an optional provider CA PEM here when needed.
DATABASE_TLS_CA=
# Production-required: exact trusted reverse-proxy IPs/CIDRs, never true or a hop count.
TRUST_PROXY=
# Railway supplies X-Real-IP. Use X-Forwarded-For only when the trusted proxy overwrites it.
PROXY_CLIENT_IP_HEADER=x-forwarded-for
# Use one exact origin (no wildcard, credentials, path, query, or fragment).
# Production origins must use HTTPS unless they are loopback-only.
CLIENT_ORIGIN=http://localhost:5173
# This privileged application origin is fixed and must not be changed.
ELECTRON_ORIGIN=app://renderer
TIMEZONE=Asia/Hebron
ADMIN_USERNAME=admin
# Required only while provisioning; use at least 15 characters and clear it afterward.
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=المدير
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Electron development override (normally unnecessary)
ELECTRON_RENDERER_URL=http://localhost:5173
