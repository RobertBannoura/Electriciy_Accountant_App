NODE_ENV=development
PORT=3000
# Replace both placeholders. Production must use a dedicated secret and a TLS-capable endpoint.
DATABASE_URL=postgresql://APP_DB_USER:CHANGE_ME@localhost:5432/electricity_accountant
# Use one exact origin (no wildcard, credentials, path, query, or fragment).
# Production origins must use HTTPS unless they are loopback-only.
CLIENT_ORIGIN=http://localhost:5173
# This privileged application origin is fixed and must not be changed.
ELECTRON_ORIGIN=app://renderer
TIMEZONE=Asia/Hebron
ADMIN_USERNAME=admin
# Required only while provisioning; use at least 15 characters and clear it afterward.
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=المدير
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
